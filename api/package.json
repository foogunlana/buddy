{
  "name": "buddy-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "chat": "tsx src/cli/chat.ts",
    "eval": "tsx evals/run.ts",
    "report": "tsx evals/report.ts",
    "view": "tsx evals/view.ts",
    "dev": "tsx watch src/server/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts.ts migrate",
    "db:seed": "tsx src/db/scripts.ts seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "openai": "^7.53.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
